// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DiscountConfig {
  id            String   @id @default(cuid())
  shop          String   @unique
  discountName  String
  discountType  String
  discountValue Float
  // Which collections the discount is scoped to when scope isn't "all" —
  // e.g. everything except a merchant's "Sale" collection. Empty = all products.
  discountCollections String[] @default([])
  // Cached Shopify discount ID (gid://shopify/DiscountCodeNode/...) so we
  // never have to rediscover it by searching for a specific code string —
  // that broke once STUDYPERKS itself was removed as a code. Set on first
  // lookup, reused after.
  discountId    String?
  updatedAt     DateTime @updatedAt
}

// A pool of unique, single-use discount codes per shop, generated in batches
// on the shop's StudyPerks discount. Replaces handing out one shared,
// guessable code to every customer — see 2026-08-03 security fix.
model StudentDiscountCode {
  id              String    @id @default(cuid())
  shop            String
  code            String
  issuedAt        DateTime?
  redeemedOrderId String?
  createdAt       DateTime  @default(now())

  @@unique([shop, code])
  @@index([shop, issuedAt])
}

model AffiliateTransaction {
  id           String   @id @default(cuid())
  shop         String
  orderId      String
  orderTotal   Float
  discountCode String
  createdAt    DateTime @default(now())
  // Set when this order is included on a generated invoice, so the next
  // invoice for this shop only picks up orders not yet billed.
  invoiceId    String?

  @@unique([shop, orderId])
}

// A generated commission invoice for one shop, covering every
// AffiliateTransaction with a matching invoiceId.
model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique
  shop            String
  periodStart     DateTime
  periodEnd       DateTime
  orderCount      Int
  revenueTotal    Float
  commissionTotal Float
  createdAt       DateTime @default(now())
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
