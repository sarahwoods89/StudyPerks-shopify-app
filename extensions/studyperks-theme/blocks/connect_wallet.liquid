{% assign logo_asset = 'StudyPerksLogo.png' %}
{% case block.settings.logo_variant %}
  {% when 'black_lime' %}{% assign logo_asset = 'studyperks-logo-black-lime.png' %}
  {% when 'blue_lime' %}{% assign logo_asset = 'studyperks-logo-blue-lime.png' %}
  {% when 'cream_black' %}{% assign logo_asset = 'studyperks-logo-cream-black.png' %}
  {% when 'cream_blue' %}{% assign logo_asset = 'studyperks-logo-cream-black.png' %}
  {% when 'lime_blue' %}{% assign logo_asset = 'studyperks-logo-black-lime.png' %}
{% endcase %}
<div class="studyperks-wrapper" data-shop="{{ shop.permanent_domain }}" style="padding-top: {{ block.settings.padding_top }}px; padding-bottom: {{ block.settings.padding_bottom }}px;">
  {% if block.settings.title_text != blank %}
    <p class="studyperks-badge__title"{% if block.settings.title_background != blank %} style="background-color: {{ block.settings.title_background }};"{% endif %}>{{ block.settings.title_text }}</p>
  {% endif %}
  <span class="studyperks-badge-shell">
    <button
      id="studyperks-wallet-connect"
      class="studyperks-badge{% if block.settings.compact_style %} studyperks-badge--compact{% endif %}"
      type="button"
      aria-label="StudyPerks — connect to claim your student discount"
    >
      <span class="studyperks-logo-wrap{% if logo_asset == 'StudyPerksLogo.png' %} studyperks-logo-wrap--plain{% endif %}">
      <img
        src="{{ logo_asset | asset_url }}"
        alt="StudyPerks"
        class="studyperks-badge__logo{% if logo_asset == 'StudyPerksLogo.png' %} studyperks-badge__logo--black{% if block.settings.logo_variant != 'plain' and block.settings.logo_style == 'white' %} studyperks-badge__logo--white{% endif %}{% endif %}"
        width="32"
        height="32"
        {% if block.settings.compact_style %}
          style="width: {{ block.settings.icon_size }}px; height: {{ block.settings.icon_size }}px;"
        {% endif %}
      />
      <span class="studyperks-power-indicator" aria-hidden="true"></span>
      </span>
    </button>
  </span>

  <div class="studyperks-account-menu" id="studyperks-account-menu">
    <p class="studyperks-account-menu__status">Verified <span class="studyperks-verified-tick">&#10003;</span> Discount ready</p>
    <button type="button" class="studyperks-account-menu__disconnect" id="studyperks-disconnect">Not you? Disconnect</button>
  </div>
  <p class="studyperks-applied-message" role="status">Verified <span class="studyperks-verified-tick">&#10003;</span> Discount ready</p>
  <button type="button" class="studyperks-inline-disconnect" id="studyperks-disconnect-inline">Not you? Disconnect</button>

  <div class="studyperks-email-prompt" id="studyperks-email-prompt">
    <div class="studyperks-email-prompt__row">
      <input
        type="email"
        id="studyperks-email-input"
        class="studyperks-email-input"
        placeholder="your@student.email"
        autocomplete="email"
      />
      <button type="button" id="studyperks-email-submit" class="studyperks-email-submit">&#8594;</button>
    </div>
    <p
      class="studyperks-email-prompt__message"
      id="studyperks-email-message"
      data-not-eligible-text="{{ block.settings.not_eligible_text | escape }}"
    ></p>
    <a
      href="https://studyperks.me/get-Verified"
      target="_blank"
      rel="noopener"
      class="studyperks-email-prompt__link"
      id="studyperks-verify-link"
    >Not verified yet? Get verified here &#8594;</a>
  </div>

  <div class="studyperks-tooltip" id="studyperks-tooltip" data-default-text="{{ block.settings.hover_text | escape }}">
    {{ block.settings.hover_text }}
  </div>

  <div class="studyperks-toast" id="studyperks-toast" role="status" aria-live="polite">
    <span class="studyperks-toast__icon" aria-hidden="true">&#10003;</span>
    <span>You're verified! Your student discount will be added automatically at checkout. Keep shopping and enjoy your savings.</span>
  </div>

</div>

<script src="{{ 'connect-wallet.js' | asset_url }}" defer></script>
{{ 'studyperks.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "StudyPerks Badge",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "logo_variant",
      "label": "Logo",
      "info": "Plain is a black logo with no background, ideal for headers.",
      "options": [
        { "value": "plain", "label": "Plain (no background)" },
        { "value": "black_lime", "label": "Black" },
        { "value": "cream_black", "label": "Off-white" },
        { "value": "blue_lime", "label": "Blue" }
      ],
      "default": "plain"
    },
    {
      "type": "checkbox",
      "id": "compact_style",
      "label": "Show as plain icon (no border or background)",
      "info": "Turn this on when placing the badge in your header, next to search/account/cart icons.",
      "default": false
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size (plain icon style only)",
      "min": 18,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title text above icon (optional)",
      "info": "Leave blank to hide. Suggested: \"Click on the StudyPerks badge for your instant discount\" — good for footers, usually skipped in headers."
    },
    {
      "type": "color",
      "id": "title_background",
      "label": "Background colour behind title text (optional)",
      "info": "Leave unset to keep it as plain text with no background."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "hover_text",
      "label": "Hover text (shown before verification)",
      "default": "Click to claim your student discount"
    },
    {
      "type": "text",
      "id": "not_eligible_text",
      "label": "Message when an email isn't verified",
      "default": "Go to StudyPerks to verify your student status — takes 30 seconds."
    }
  ]
}
{% endschema %}
